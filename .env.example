# Local development settings. Copy to .env.local (git-ignored); Next.js and the npm scripts load it.
# Matches infra/dev/compose.yaml. Production settings live in /opt/research-hub/.env on the server
# (see infra/env.example), never in the repository.
DATABASE_URL=postgres://rh:rh_dev_only@127.0.0.1:5432/rh_dev
SITE_URL=http://localhost:3000
# Tests reset this database completely; it must be a separate one whose name contains "test".
TEST_DATABASE_URL=postgres://rh:rh_dev_only@127.0.0.1:5432/rh_test

# Research Hub reverse proxy (Phase 2: server-rendered app behind Caddy).
#
# Site address comes from CADDY_SITE_ADDRESS in /opt/research-hub/.env:
#   before ICP filing:  CADDY_SITE_ADDRESS=:80        (direct IP, plain HTTP)
#   after filing:       CADDY_SITE_ADDRESS=example.cn, www.example.cn
# With a domain as the address Caddy obtains and renews TLS certificates automatically and
# redirects HTTP to HTTPS. No file change is needed for the switch: edit .env, then run
#   infra/remote/apply-config.sh
{
	# The admin API listens on localhost:2019 inside the container only (no port is published),
	# which is what `caddy reload` uses during deploys.
	persist_config off
}

{$CADDY_SITE_ADDRESS::80} {
	encode zstd gzip

	# Next.js emits content-hashed assets; cache them forever.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
		-X-Powered-By
	}

	# Uploaded media (module structure diagrams, slice 5). Public by design; never executable.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=86400"
		header Content-Security-Policy "default-src 'none'; sandbox"
		file_server
	}

	handle {
		reverse_proxy app:3000 {
			# Hold requests while the app container restarts during a deploy (2-4 s) instead of
			# answering 502: visitors see a slow response, not an error.
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	# Access log: client IPs are truncated (IPv4 /24, IPv6 /48) so no full IP is stored; Caddy
	# already redacts Cookie and Authorization headers. Retention is bounded by the Docker log
	# rotation in compose.yaml. Keep this in line with the privacy policy (app/(account)/privacy).
	log {
		output stdout
		format filter {
			wrap console
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
		}
		level INFO
	}
}

# /opt/research-hub/.env  --  created by infra/remote/bootstrap.sh (chmod 600, root-owned).
# NEVER commit a real copy of this file. Values here are placeholders.

# Public origin used for canonical URLs, sitemap.xml and robots.txt. Read at runtime: changing it
# needs only `infra/remote/apply-config.sh`, no rebuild.
SITE_URL=http://129.204.142.223

# Caddy site address. ":80" = direct IP over plain HTTP (before ICP filing).
# After filing:  CADDY_SITE_ADDRESS=example.cn, www.example.cn   and   SITE_URL=https://www.example.cn
CADDY_SITE_ADDRESS=:80

# Generated by bootstrap.sh (hex, URL-safe). Changing it after first start requires
# ALTER ROLE rh PASSWORD '...' inside the database as well.
POSTGRES_PASSWORD=change-me

# Slice 2 (accounts). Generated by bootstrap.sh. Changing it logs everyone out and makes stored
# TOTP secrets unreadable (admins then need create-admin --reset-mfa).
AUTH_SECRET=change-me

# Accounts stay OFF (all account pages 404, no login link) unless AUTH_ENABLED=1 AND SITE_URL is
# https://. Browsers drop Secure cookies on plain HTTP and passwords must never travel in clear.
AUTH_ENABLED=0

# Mail: hold (no provider: messages stay in the outbox, self-service password reset is off),
# smtp (real delivery), log (development only).
MAIL_DRIVER=hold
# smtps://user:password@smtp.example.com:465   (Tencent Cloud blocks port 25)
SMTP_URL=
MAIL_FROM="科研 AI 资源工作台 <noreply@example.cn>"

# Named in the privacy policy and terms (PIPL). Placeholders are shown until these are set.
OPERATOR_NAME=
CONTACT_EMAIL=

# Filing numbers shown in the footer once granted (empty = hidden).
ICP_RECORD=
PSB_RECORD=

# Slice 7 (ingestion, /admin/ingest/). Server-side only; never exposed to the browser.
# Empty = the import feature is off. The worker runs inside the app container.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Stop calling DeepSeek for the rest of the day (Asia/Shanghai) after this many tokens.
DEEPSEEK_DAILY_TOKEN_LIMIT=2000000
# Query mode needs a web-search API (DeepSeek cannot search). Supported: bocha (博查).
# Empty = import by URL only.
SEARCH_PROVIDER=
BOCHA_API_KEY=

# Off-box backup hook, run once per backup file with {file} replaced by its path, e.g.
#   BACKUP_OFFSITE_CMD=coscli cp {file} cos://research-hub-backup-1250000000/nightly/
# Empty = backups stay on this disk only (backup.sh logs a warning every night).
BACKUP_OFFSITE_CMD=

# GPT Plus top-nav promotion. All values are server-only; never expose the secret client-side.
# Shop URL is the external purchase link. Price = API supply cost * (1 + markup percent), one decimal.
GPT_PROMO_SHOP_URL=
GPT_PROMO_GOODS_NO=
GPT_PROMO_APP_ID=
GPT_PROMO_APP_SECRET=
GPT_PROMO_MARKUP_PERCENT=20
GPT_PROMO_REFRESH_SECONDS=600

# Image overrides, e.g. for a registry mirror reachable from mainland China.
# NODE_IMAGE=node:24-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# CADDY_IMAGE=caddy:2-alpine

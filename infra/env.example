# /opt/research-hub/.env  --  created by infra/remote/bootstrap.sh (chmod 600, root-owned).
# NEVER commit a real copy of this file. Values here are placeholders.

# Public origin used for canonical URLs, sitemap.xml and robots.txt. Read at runtime: changing it
# needs only `infra/remote/apply-config.sh`, no rebuild.
SITE_URL=http://129.204.142.223

# Caddy site address. ":80" = direct IP over plain HTTP (before ICP filing).
# After filing:  CADDY_SITE_ADDRESS=example.cn, www.example.cn   and   SITE_URL=https://www.example.cn
CADDY_SITE_ADDRESS=:80

# Generated by bootstrap.sh (hex, URL-safe). Changing it after first start requires
# ALTER ROLE rh PASSWORD '...' inside the database as well.
POSTGRES_PASSWORD=change-me

# Slice 2 (sessions). Generated by bootstrap.sh.
AUTH_SECRET=change-me

# Filing numbers shown in the footer once granted (empty = hidden).
ICP_RECORD=
PSB_RECORD=

# Slice 7 (ingestion). Server-side only; never exposed to the browser.
DEEPSEEK_API_KEY=

# Off-box backup hook, run once per backup file with {file} replaced by its path, e.g.
#   BACKUP_OFFSITE_CMD=coscli cp {file} cos://research-hub-backup-1250000000/nightly/
# Empty = backups stay on this disk only (backup.sh logs a warning every night).
BACKUP_OFFSITE_CMD=

# Image overrides, e.g. for a registry mirror reachable from mainland China.
# NODE_IMAGE=node:24-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# CADDY_IMAGE=caddy:2-alpine

{
  "name": "research-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "content:import": "tsx --env-file-if-exists=.env.local scripts/import-content.ts",
    "release": "node scripts/build-release.mjs",
    "parity": "node tools/parity/compare.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "markdown-it": "^15.0.3",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "pinyin-pro": "^3.29.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}

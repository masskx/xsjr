{
  "name": "research-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "content:import": "tsx --env-file-if-exists=.env.local scripts/import-content.ts",
    "bulk": "tsx --env-file-if-exists=.env.local scripts/bulk-import.ts",
    "release": "node scripts/build-release.mjs",
    "parity": "node tools/parity/compare.mjs",
    "e2e": "node tests/e2e/auth-flow.mjs && node tests/e2e/admin-prompts.mjs && node tests/e2e/tiers.mjs && node tests/e2e/gallery.mjs && node tests/e2e/analytics.mjs && node tests/e2e/ingest.mjs && node tests/e2e/v23.mjs"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource-variable/alumni-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@mozilla/readability": "^0.6.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.2",
    "hash-wasm": "^4.13.0",
    "highlight.js": "^11.12.0",
    "linkedom": "^0.18.15",
    "markdown-it": "^15.0.3",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pinyin-pro": "^3.29.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
